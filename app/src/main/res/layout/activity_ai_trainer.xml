<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trainerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <!-- Premium Header -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HANA PREMIUM AI TRAINER"
            android:textColor="#FFB300"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE TRACKING"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#1B5E20"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- Level Selection Container -->
    <LinearLayout
        android:id="@+id/llLevelSelector"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/llHeader"
        app:layout_bottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Your Training Level"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI will calibrate voice &amp; tracking parameters"
            android:textColor="#888888"
            android:textSize="14sp"
            android:layout_marginBottom="32dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBeginner"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="BEGINNER (Squats &amp; Form Calibration)"
            android:textColor="#FFFFFF"
            android:backgroundTint="#222222"
            app:strokeColor="#FFB300"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnIntermediate"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="INTERMEDIATE (Plank &amp; Core Balance)"
            android:textColor="#FFFFFF"
            android:backgroundTint="#222222"
            android:layout_marginBottom="16dp"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExpert"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="EXPERT (High Intensity &amp; Precision)"
            android:textColor="#FFFFFF"
            android:backgroundTint="#222222"
            app:cornerRadius="12dp" />
    </LinearLayout>

    <!-- Active Trainer View (Hidden Initially) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTrainerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/llHeader"
        app:layout_bottom_toBottomOf="parent">

        <!-- Top Box: Premium Avatar Display -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAvatar"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_margin="16dp"
            app:cardBackgroundColor="#111111"
            app:cardCornerRadius="16dp"
            app:strokeColor="#333333"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Simulating a high tech cybernetic human avatar view -->
                <ImageView
                    android:id="@+id/ivAvatarGraphic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_menu_directions"
                    android:scaleType="centerInside"
                    android:padding="24dp"
                    android:tint="#FFB300" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:drawable/screen_background_dark_transparent" />

                <TextView
                    android:id="@+id/tvAvatarInstruction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:text="AI Model: Keep your back straight"
                    android:textColor="#FFB300"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bottom Box: Camera Feed Preview (Placeholder or simulated scan line overlay) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCamera"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="16dp"
            app:cardBackgroundColor="#1A1A1A"
            app:cardCornerRadius="16dp"
            app:strokeColor="#FFB300"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/cardAvatar"
            app:layout_bottom_toTopOf="@id/llControls">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Mock Camera preview icon or background feed -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@android:drawable/ic_menu_camera"
                    android:scaleType="center"
                    android:alpha="0.15"
                    android:tint="#FFFFFF" />

                <View
                    android:id="@+id/vScanLine"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#00E676" />

                <TextView
                    android:id="@+id/tvFeedbackText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Initializing Real-time Camera Feed..."
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="italic" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Controls row -->
        <LinearLayout
            android:id="@+id/llControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            app:layout_bottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimulateCorrection"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginRight="8dp"
                android:text="Test Wrong Posture"
                android:backgroundTint="#D50000"
                app:cornerRadius="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetTrainer"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:text="Exit Trainer"
                android:backgroundTint="#333333"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>